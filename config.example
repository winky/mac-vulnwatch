# mac-vulnwatch configuration
#
# Copy to ~/.config/mac-vulnwatch/config. Every key is optional; KEY=value, one per line.
# Any key can also be set from the environment as MAC_VULNWATCH_<KEY>.

# Mirror findings as issues in this repository (owner/name). Use a private repository: the
# issues list what is installed on your machine. Leave empty to keep reports local only.
# Needs the gh CLI, logged in (gh auth login).
#GITHUB_REPO=your-name/machine-vulns

# What to call this machine in issue titles and labels. Defaults to the LocalHostName.
#HOST=mac-mini

# Which collectors to run, space or comma separated.
# Available: macos brew cask mas runtime packages docker (docker is off by default; it needs trivy).
#COLLECTORS=macos brew cask mas runtime packages

# Show a macOS notification when a scan finds something it did not find last time.
#NOTIFY=true

# Include casks that update themselves (auto_updates, version :latest).
#CASK_GREEDY=false

# Severities the docker collector reports (trivy's --severity).
#DOCKER_SEVERITY=HIGH,CRITICAL

# Where latest.json and latest.md are written.
#STATE_DIR=~/.local/state/mac-vulnwatch
